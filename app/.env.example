# Starcrop app environment. Copy to app/.env for local runs (npm run dev and test/record.mjs read it; the shell wins).
# On Netlify set the same names under Site configuration > Environment variables. Never commit values.

# GitHub token for every GitHub REST and search call. Required for real use: without it GitHub allows 60 calls/hour
# per IP (about 2 reports); with it 5,000/hour and 30 searches/minute. A fine-grained token with no scopes (public read) is enough.
GITHUB_TOKEN=

# Helius API key (recommended): DAS getAsset reads a pump.fun mint's metadata to find the repo (10 credits per mint, cached 1 h).
# Without it mints resolve through DexScreener, then pump.fun.
HELIUS_API_KEY=

# The $STCROP mint once the coin exists; /api/health returns it as tokenMint (null while empty). Nothing else depends on it.
TOKEN_MINT=

# Not used by any endpoint; /api/health only reports whether it is set (keys.birdeye).
BIRDEYE_API_KEY=

# Local only: folder for the file-based store that replaces Netlify Blobs (npm run dev sets app/.data). Never set it on Netlify.
# LOCAL_STORE_DIR=

# Cloudflare Workers only (wrangler.jsonc sets CF_FREE_PLAN=1; on Workers Paid set it to 0). With 1: at most 45 upstream
# requests per invocation, 12 starred-list pages per survey, one heavy step per scheduled run. See README.md.
# CF_FREE_PLAN=
# Optional overrides of those two budgets (unset: 45 and 12 with CF_FREE_PLAN=1; no cap and 28 otherwise).
# SURVEY_FETCH_BUDGET=
# SURVEY_STARRED_PAGES=
